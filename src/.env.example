# ==========================================
# Configuración del Servidor
# ==========================================
PORT=3000

# ==========================================
# Configuración de la Base de Datos MySQL
# ==========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=sistema_academico
DB_PORT=3306

# ==========================================
# Configuración de Seguridad (JWT)
# ==========================================
# Cambia este valor por una cadena alfanumérica segura y larga en tu entorno local
JWT_SECRET=tu_super_secreto_jwt_aqui
JWT_EXPIRES_IN=8h

# ==========================================
# Configuración SMTP - DESARROLLO (Mailtrap / Pruebas)
# Se puede usar por ejemplo: Mailinator como receptor de correos de prueba.
# ==========================================
DEV_EMAIL_HOST=sandbox.smtp.mailtrap.io
DEV_EMAIL_PORT=2525
DEV_EMAIL_USER=usuario_mailtrap
DEV_EMAIL_PASS=clave_mailtrap
DEV_EMAIL_RECEIVER=test_bedelia@midominio.local

# ==========================================
# Configuración SMTP - PRODUCCIÓN (Gmail Bedelía) Cambiar a tu cuenta de Gmail y generar una contraseña de aplicación para usarla aquí.
# ==========================================
PROD_EMAIL_HOST=smtp.gmail.com
PROD_EMAIL_PORT=465
PROD_EMAIL_USER=mail_de_bedelia
PROD_EMAIL_PASS=clave_de_aplicacion_google
PROD_EMAIL_RECEIVER=mail_de_bedelia